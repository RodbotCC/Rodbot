# Allowlist approach: $HOME is the repo, but almost nothing in $HOME belongs in git.
# Ignore everything by default...
/*

# ...then explicitly re-include what RodBot tracks.
!.gitignore
!README.md
!AGENTS.md
!CLAUDE.md
!ledgers/
!intake/
!scripts/
!pieces/

# Inside tracked dirs, still exclude noisy artifacts.
.DS_Store
*.swp
*.swo
Thumbs.db

# Runtime artifacts for filesystem trigger pipeline.
ledgers/moves/events.log
ledgers/moves/phase1-detector.stdout.log
ledgers/moves/phase1-detector.stderr.log
ledgers/moves/settled.log
ledgers/moves/phase2-debouncer.stdout.log
ledgers/moves/phase2-debouncer.stderr.log
ledgers/moves/inbox/
ledgers/moves/.phase2-pending/
ledgers/moves/duplicates.log
ledgers/moves/vanished.log
ledgers/moves/.phase3-cursor
ledgers/moves/phase3-inbox-writer.stdout.log
ledgers/moves/phase3-inbox-writer.stderr.log
